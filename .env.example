# ─── Telegram ───────────────────────────────────────────────
# Отримай від @BotFather командою /newbot
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL твого GitHub Pages (де лежить index.html)
# Формат: https://{username}.github.io/{repo-name}/
MINI_APP_URL=https://yourusername.github.io/fitness-pwa/

# ─── Backend (Render.com) ────────────────────────────────────
# URL твого FastAPI після деплою на Render.com
# Вкажи також у index.html const API_URL = '...'
BACKEND_URL=https://fittrack-api.onrender.com

# ─── Firebase ────────────────────────────────────────────────
# Сервісний ключ з Firebase Console:
# Project Settings → Service Accounts → Generate new private key
# Весь JSON в один рядок (або встав шлях до файлу)
FIREBASE_KEY_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─── CORS ────────────────────────────────────────────────────
# Дозволений origin для бекенду (GitHub Pages URL)
ALLOWED_ORIGIN=https://yourusername.github.io
